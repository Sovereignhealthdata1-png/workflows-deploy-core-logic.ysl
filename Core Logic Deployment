name: Deploy C# Core Logic
on:
  push:
    branches:
      - main
    paths:
      - 'core-logic/**' # Triggers ONLY when files in this folder change
  workflow_dispatch:

permissions:
  id-token: write # Required for Azure OIDC authentication
  contents: read  # Required for actions/checkout

jobs:
  deploy-csharp:
    runs-on: ubuntu-latest
    steps:
      - name: 'Checkout Code'
        uses: actions/checkout@v4

      - name: 'Setup .NET SDK'
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'

      - name: 'Build and Publish C# Project'
        run: |
          dotnet publish core-logic/Platform.Verification.csproj --configuration Release --output ./cs-output

      - name: 'Azure Login via OIDC'
        uses: azure/login@v1
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: 'Deploy C# to Azure Function'
        uses: azure/functions-action@v1
        with:
          app-name: 'pilot-sovereign'
          package: './cs-output'
